# Hy-Memory 配置模板（变量名已对 2.0.5 官方 README 核实）
# 用法：复制为 .env 后填入真实值；.env 不要提交到任何仓库

# ===== Embedding（必需，lite 模式只需这一组）=====
# 硅基流动（推荐，bge-m3 中文效果好，有免费额度）
MEMORY_EMBEDDER_BASE_URL=https://api.siliconflow.cn/v1
MEMORY_EMBEDDER_MODEL=BAAI/bge-m3
MEMORY_EMBEDDER_API_KEY=sk-请填入硅基流动key

# 备选：阿里 DashScope
# MEMORY_EMBEDDER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MEMORY_EMBEDDER_MODEL=text-embedding-v3

MEMORY_EMBEDDING_DIMS=1024

# ===== LLM（可选，仅 pro / ultra 模式的记忆抽取需要）=====
# 走本机 ysjx 网关（OpenAI 兼容）
MEMORY_LLM_BASE_URL=https://newapi.jxdata.com:18000/v1
MEMORY_LLM_MODEL=deepseek-v4-flash
MEMORY_LLM_API_KEY=请填入YSJX_API_KEY

# ===== 图记忆（可选）=====
# ultra 模式强制要求；lite / pro 可关闭以省资源
MEMORY_ENABLE_GRAPH=false

# ===== 代码场景（可选）=====
# MEMORY_CODING_CHAIN_REPO_ROOT=D:\code\iisw_be
# MEMORY_CODING_CHAIN_BLOCK_ENABLED=true
