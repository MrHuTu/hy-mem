# 构建产物与中间物——一律不入库，用 scripts/build_exe.py 重新生成（约 110s）
build/
dist/
# 本地环境与模型缓存——pip install -r requirements.txt / 首跑 fastembed 自动下载
.venv/
.models/
# Python 字节码
__pycache__/
*.pyc
# WorkBuddy 会话/记忆数据
.workbuddy/

# 密钥文件——永不入库
config.json
.env

# Windows 设备名误产物：在 bash 里 `> nul` 会落成一个真实文件，而且删不掉（设备名冲突）
/nul

# 本地临时脚本——排查 bug、一次性实验、探针，一律不入库
# 约定：scripts/ 只放业务相关（构建、提交闸门、测试套件、密钥入口），
# 临时/诊断脚本放这里。本目录会随工作区在，但永远不进 git。
.local-test/

# 运行时数据——记忆库 / 向量库 / 队列库 / 日志 / 写锁 / 端点登记，
# 全是本机状态：随每次 add/search 变化，commit 进去等于把个人记忆库发上 GitHub。
# 目录由程序自建（config.default_data_dir()），新克隆不依赖它存在。
# 用 /data/ 锚定仓库根：不要误伤别处同名的 data 目录
/data/
# 数据目录可能因 app_root 判定偏移误落在包内任意层（S1 暗雷实录），
# 逐层防：src/ 下任何位置的 data/ 都不入库
src/**/data/
*.egg-info/
# PyInstaller 每次构建自动改写根目录 spec（build_exe.py 不走它），
# 纯构建副产物，不跟踪
/hy-mem.spec
